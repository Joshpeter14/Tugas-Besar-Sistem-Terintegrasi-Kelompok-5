# Salin file ini menjadi .env lalu isi nilainya.
PORT=4000

# Alamat Service Antrean. Lokal: http://localhost:3000, setelah deploy: https://nama-project.vercel.app
ANTREAN_API_URL=http://localhost:3000
# Harus sama dengan API_KEY di Service Antrean
ANTREAN_API_KEY=ganti-dengan-kunci-rahasia
ANTREAN_TIMEOUT_MS=10000

# Lokasi file database SQLite (default: data/rekam.db)
# DB_FILE=data/rekam.db
